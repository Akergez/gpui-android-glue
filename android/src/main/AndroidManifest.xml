<?xml version="1.0" encoding="utf-8" ?>
<!--
  Merged into the application's manifest. The helper activities gpui-mobile's
  packages start are declared here, so that an application only declares its
  own activity (dev.gpui.mobile.GpuiActivity, with its library name and
  intent filters) and the permissions it asks for.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Predictive back (back.rs, GpuiBack.java): the gesture goes to the
         application's callback while it has something to take back, with
         its progress from Android 14, and is the system's animation home
         when it has not. Merged into the application's <application>. -->
    <application android:enableOnBackInvokedCallback="true">
        <!-- File prompts and saving a document (documents.rs): SAF grants
             access only to the document the person chooses. -->
        <activity
            android:name="dev.gpui.mobile.GpuiPathPicker"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />
        <!-- File and image picker results. -->
        <activity
            android:name="dev.gpui.mobile.GpuiPickerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />
        <!-- Runtime permission requests. -->
        <activity
            android:name="dev.gpui.mobile.GpuiPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />
        <!-- Biometric authentication (BiometricPrompt). -->
        <activity
            android:name="dev.gpui.mobile.GpuiAuthActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />
    </application>
</manifest>
